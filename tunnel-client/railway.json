{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/tunnel-client/Dockerfile",
    "watchPatterns": [
      "/tunnel-client/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS"
  }
}
